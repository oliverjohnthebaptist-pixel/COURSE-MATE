# ---- AI (required) ----
GROQ_API_KEY=your-new-groq-key
# free = Groq free tier (slow for big summaries). developer = Groq pay-as-you-go plan (much faster). Change it when you upgrade.
GROQ_PLAN=free
# Models that exist today. (llama-3.3-70b, llama-3.1-8b and qwen3-32b were shut down by Groq in 2026 and answer "404".)
# AI_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# ---- Your website address (no slash at the end) ----
APP_URL=http://localhost:3000
PORT=3000
# Optional local persistent storage path for non-serverless hosting.
# COURSEMATE_STORAGE_DIR=/var/data/coursemate

# ---- Supabase (login) ----
SUPABASE_URL=https://lohjifbvrbnqxamroxtp.supabase.co
# Public key used only for Supabase Auth requests.
SUPABASE_ANON_KEY=your-supabase-publishable-key
# Secret server-side key used by data migration and server-side Supabase access. Never expose it in browser code.
SUPABASE_SERVICE_KEY=

# ---- Owner access (private) ----
# Your own login email(s), comma separated. The account must be confirmed. Leave empty to switch off.
ADMIN_EMAILS=

# ---- Feedback delivery (Resend) ----
# The sender domain/address must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CourseMate <feedback@your-verified-domain.com>
