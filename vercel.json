{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "login.html",
        "signup.html",
        "logo.png",
        "logo-mascot.webp",
        "public/**"
      ],
      "maxDuration": 60
    }
  }
}
